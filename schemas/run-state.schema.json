{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heh139811-droid/deep_agent/schemas/run-state.schema.json",
  "title": "SddState",
  "description": "AgentState['sdd'] — SDD orchestration metadata. NOT the LangGraph checkpoint; the checkpointer owns messages/todos/files.",
  "type": "object",
  "required": [
    "run_id",
    "feature_id",
    "verify_passed",
    "spawn_history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "LangGraph thread key. MVP: same value as run_id"
    },
    "feature_id": {
      "type": "string"
    },
    "stage": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pipeline hint 0-9. Gates MUST NOT trust this field",
      "enum": [
        "0-sources",
        "1-spec-draft",
        "2-questions",
        "3-decide",
        "4-rereview",
        "5-crosscheck",
        "6-ready",
        "6b-human-gate",
        "7-implement",
        "8-qa",
        "8b-triage",
        "9-report",
        null
      ]
    },
    "spec_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "verify_passed": {
      "type": "boolean",
      "description": "Gate truth source. Only gates.verify_spec() may set this to true"
    },
    "ready_open_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Open items in ready.md section 1. MUST be 0 before implement (G_READY)"
    },
    "last_event": {
      "type": [
        "string",
        "null"
      ]
    },
    "waiting_for": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "sources",
        "human_gate",
        null
      ]
    },
    "target_repo_path": {
      "type": [
        "string",
        "null"
      ],
      "description": "Real disk path for implement/qa. Code never lives in AgentState.files"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "spent_usd": {
          "type": "number",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "spawn_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spawn_id",
          "skill",
          "model",
          "brief",
          "at"
        ],
        "properties": {
          "spawn_id": {
            "type": "string"
          },
          "skill": {
            "type": "string",
            "enum": [
              "spec-write",
              "openspec",
              "spec-kit",
              "decide",
              "spec-rereview",
              "crosscheck",
              "ready-audit",
              "implement",
              "qa",
              "e2e-triage"
            ]
          },
          "model": {
            "type": "string"
          },
          "brief": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": [
              "string",
              "null"
            ]
          },
          "event": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokens_in": {
            "type": [
              "integer",
              "null"
            ]
          },
          "tokens_out": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cost_usd": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "gate_rejects": {
      "type": "array",
      "description": "Recent rejections injected into Main context so it replans instead of retrying the same wall",
      "items": {
        "type": "object",
        "required": [
          "code",
          "at"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "G_MODEL_KNOWN",
              "G_NO_IMPL_WITHOUT_VERIFY",
              "G_READY",
              "G_ANSWERS_HUMAN",
              "G_SESSION_QA",
              "G_BUDGET",
              "G_DECISION_LOGGED",
              "G_HUMAN_GATE",
              "G_OPENSPEC_VALID",
              "G_TRIAGE_FIRST",
              "G_LOOP",
              "G_TEST_INTEGRITY",
              "G_STORE_WRITE"
            ]
          },
          "message": {
            "type": "string"
          },
          "skill": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "human_gate": {
      "type": [
        "object",
        "null"
      ],
      "description": "Permission/billing stop. Union of AI-flagged and gate-rescanned items; AI cannot clear it.",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "raised_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "answered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "description": "decisions.md index. [AI 결정] needs rationale/alternatives/confidence (G_DECISION_LOGGED); category 권한|과금 raises the human gate - but the gate rescans independently and does not trust this field.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tag",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{3,}$"
          },
          "tag": {
            "type": "string",
            "enum": [
              "[코드]",
              "[AI 결정]",
              "[답변]",
              "[정지 후보]",
              "[CROSS]"
            ]
          },
          "text": {
            "type": "string"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ],
            "description": "Must be a citation (file#Lnn or D-nnn) for [AI 결정]"
          },
          "alternatives": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "상",
              "중",
              "하",
              null
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "일반",
              "권한",
              "과금"
            ],
            "default": "일반"
          },
          "by": {
            "type": "string",
            "enum": [
              "decide",
              "crosscheck",
              "spec-rereview",
              "human"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set only via POST /human-gate"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
