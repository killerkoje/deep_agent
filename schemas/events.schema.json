{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heh139811-droid/work_flow_ochestration_agent/schemas/events.schema.json",
  "title": "DeepAgentEvent",
  "type": "object",
  "required": ["event", "run_id", "feature_id", "ts", "actor"],
  "properties": {
    "event": {
      "type": "string",
      "enum": [
        "prd.ready",
        "spec.draft.ready",
        "questions.ready",
        "answers.ready",
        "spec.verify.passed",
        "spec.verify.failed",
        "impl.pr.ready",
        "qa.passed",
        "qa.failed",
        "run.report.ready"
      ]
    },
    "run_id": { "type": "string", "minLength": 1 },
    "feature_id": { "type": "string", "minLength": 1 },
    "ts": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "string",
      "description": "human | main | gate | skill id"
    },
    "spec_ref": {
      "type": ["string", "null"],
      "description": "path@sha256:…"
    },
    "spawn_id": { "type": ["string", "null"] },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" },
      "description": "verify/qa failure reasons"
    },
    "pr_url": { "type": ["string", "null"] },
    "patch_path": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
