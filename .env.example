# --- OpenAI ---
OPENAI_API_KEY=sk-...

# Main model is env-fixed for cost control (SPEC Q1).
# Sub-agent models are NOT set here - Main picks one per spawn from config/models.available.json.
# Never add MODEL_FOR_IMPLEMENT / MODEL_FOR_QA style vars: that is the forbidden assignment table.
MAIN_MODEL=gpt-6-luna
MAIN_REASONING_EFFORT=high

# Store (long-term memory) embedding. 1536d fits pgvector HNSW (limit 2000d).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# --- Server ---
ORCH_API_TOKEN=change-me

# --- Postgres (Phase C: checkpointer / Phase E: store + pgvector) ---
DATABASE_URL=postgresql://deep_agent:change-me@localhost:5432/deep_agent

# --- Store namespace (SPEC Q7: single org for MVP) ---
ORG_ID=default
USER_ID=default

# --- Budget (optional, G_BUDGET) ---
# RUN_MAX_USD=5.0

# --- Target repo for implement/qa ---
# TARGET_REPO_PATH=C:/Users/PC/Documents/your_service_repo
